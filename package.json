  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "node --stack-size=8000 ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "unused": "knip",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run unused",
    "seed:words": "tsx scripts/seed-words.ts",
    "words:check": "tsx scripts/check-words.ts",
    "words:apply": "tsx scripts/apply-words.ts",
    "art:check": "tsx scripts/check-art.ts",
    "art:ack": "tsx scripts/check-art.ts --ack",
    "figma:check": "tsx scripts/check-figma.ts",
    "figma:diff": "node scripts/pixel-diff.mjs",
    "figma:audit": "node scripts/audit-screens.mjs",
    "rls:audit": "tsx scripts/rls-audit.ts"
  },
  "private": true
