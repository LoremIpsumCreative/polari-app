{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "scripts/*.{ts,mjs}"],
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  "ignore": ["src/types/database.ts"],
  "ignoreDependencies": ["expo-updates", "expo-system-ui", "expo-status-bar"],
  "ignoreBinaries": ["ffmpeg"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
